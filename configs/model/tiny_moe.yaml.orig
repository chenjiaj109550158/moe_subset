schema_version: 1
experiment:
  name: tiny_moe_inspection
  seed: 1234
  information_regime: online_pre_sample
model:
  vocab_size: 32
  hidden_size: 16
  num_layers: 2
  num_heads: 4
  num_experts: 4
  top_k: 2
  expert_hidden_size: 24
  max_sequence_length: 64
  use_rope: true
  shared_expert: false
  synthetic_expert_bytes: 4096
decode:
  max_new_tokens: 4
  eos_token_id: null

